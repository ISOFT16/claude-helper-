# Скопируй этот файл в ".env" и впиши ключи. Файл .env НИКОМУ не показывай
# и не загружай на GitHub (он уже добавлен в .gitignore).
# Без ключей приложение работает в ДЕМО-режиме.

# --- ИИ для конспекта, чата, тестов и карточек ---
# Вариант 1 (основной): Claude. Ключ: https://platform.claude.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Вариант 2: любой сервис, совместимый с OpenAI (используется, если ANTHROPIC_API_KEY пуст)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# --- Распознавание речи (сервис, совместимый с OpenAI Whisper API) ---
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# --- Защита и ограничение расходов ---
# Код доступа: без него никто не сможет тратить твои ключи. Обязательно задай, если сервер виден из интернета.
ACCESS_CODE=
MAX_AUDIO_MINUTES=75
MAX_UPLOAD_MB=200
DAILY_LESSON_LIMIT=10
DAILY_CHAT_LIMIT=100
DAILY_AUDIO_MINUTES=300

PORT=8787
