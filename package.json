{
  "name": "umny-urok",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Умный урок — AI School: запись урока, ИИ-конспект, домашние задания, тесты и карточки",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "build:link": "vite build -c standalone/vite.config.ts && node standalone/assemble.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "idb": "^8.0.4",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
